# Elysium relays, comma-separated, in the order you trust them. Every signed transaction goes to ALL of them at once
# (first acceptance wins); reads run over the fast ones. Leave empty for the defaults (Agoradex, Volta, Kleos, ElysPump).
# Put the official Conduit endpoint first the day it opens.
ELYSIUM_RPC_URLS=
# Optional: relays reads run over, when different from the send list.
ELYSIUM_READ_RPC_URLS=

# IPFS pinning for the coin's image and Ascend's metadata JSON (one of the two). QuickNode: an IPFS-enabled API key.
QUICKNODE_API_KEY=
QUICKNODE_IPFS_GATEWAY=
# or Pinata
PINATA_JWT=

# Where your wallet files live. Leave empty for ./wallets inside this repo (git-ignored). Set the same folder in every
# starter to share wallets; this app only reads files with "chain": "ely".
WALLET_BACKUP_DIR=

PORT=3000
